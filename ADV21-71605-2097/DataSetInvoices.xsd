            <MainSource>
              <DbSource ConnectionRef="DoCarsDBConnectionString (Settings)" DbObjectName="dbo.Services" DbObjectType="Table" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT 
    'Service' AS ItemType,
    s.Name AS ItemName,
    1 AS Quantity,
    s.Price AS UnitPrice,
    CASE 
        WHEN sa.Discounted = 1 THEN s.Price * 0.90 
        ELSE s.Price 
    END AS LineTotal
FROM ServiceAppointmentsServices sas
JOIN Services s ON sas.ServiceID = s.ServiceID
JOIN ServiceAppointments sa ON sas.AppointmentID = sa.AppointmentID
WHERE sas.AppointmentID = @AppointmentID

UNION ALL


SELECT 
    'Part' AS ItemType,
    p.Name AS ItemName,
    sasp.Quantity,
    p.SellPrice AS UnitPrice,
    CASE 
        WHEN sa.Discounted = 1 THEN (p.SellPrice * sasp.Quantity) * 0.90 
        ELSE (p.SellPrice * sasp.Quantity) 
    END AS LineTotal
FROM ServiceAppointmentsServicesParts sasp
JOIN Parts p ON sasp.PartID = p.PartID
JOIN ServiceAppointments sa ON sasp.AppointmentID = sa.AppointmentID
WHERE sasp.AppointmentID = @AppointmentID;
</CommandText>
