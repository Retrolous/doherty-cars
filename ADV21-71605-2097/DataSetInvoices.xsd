              <DbSource ConnectionRef="DoCarsDBConnectionString (Settings)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>-- get the total revenue generate by each service appointment due to services
WITH ServiceTotals AS (
    SELECT 
        sas.AppointmentID,
        SUM(s.Price) AS TotalServicesPrice
    FROM ServiceAppointmentsServices sas
    JOIN Services s ON sas.ServiceID = s.ServiceID
    GROUP BY sas.AppointmentID
),
-- get the total revenue generate by each service appointment due to parts
PartsTotals AS (
    SELECT 
        sasp.AppointmentID AS AppointmentID,
        SUM(p.SellPrice * sasp.Quantity) AS TotalPartsPrice
    FROM ServiceAppointmentsServicesParts sasp
    JOIN Parts p ON sasp.PartID = p.PartID
    GROUP BY sasp.AppointmentID
)

SELECT 
    sa.AppointmentID,
    sa.AppointmentStart,
    sa.AppointmentEnd,
    sa.Discounted,
    st.Firstname AS StaffFirstname,
    st.Surname AS StaffSurname,
    r.Name AS StaffRole,

    v.Make,
    v.Model,
    v.Year,
    v.LicensePlate,
    c.Firstname AS CustomerFirstname,
    c.Surname AS CustomerSurname,
    c.Email,
    c.PhoneNumber,

    COALESCE(stot.TotalServicesPrice, 0) AS SubtotalServices,
    COALESCE(ptot.TotalPartsPrice, 0) AS SubtotalParts,
    
    (COALESCE(stot.TotalServicesPrice, 0) + COALESCE(ptot.TotalPartsPrice, 0)) AS RawTotal,
-- ensure that discount logic is applied properly
    CASE 
        WHEN sa.Discounted = 1 THEN (COALESCE(stot.TotalServicesPrice, 0) + COALESCE(ptot.TotalPartsPrice, 0)) * 0.10
        ELSE 0 
    END AS TotalSavings,

    CASE 
        WHEN sa.Discounted = 1 THEN (COALESCE(stot.TotalServicesPrice, 0) + COALESCE(ptot.TotalPartsPrice, 0)) * 0.90
        ELSE (COALESCE(stot.TotalServicesPrice, 0) + COALESCE(ptot.TotalPartsPrice, 0))
    END AS GrandTotal

FROM ServiceAppointments sa
JOIN Staff st ON sa.StaffID = st.StaffID
JOIN Roles r ON st.RoleID = r.RoleID
JOIN Vehicles v ON sa.VehicleID = v.VehicleID
-- left join as certain appointment may not have customers, services or parts
LEFT JOIN Customers c ON v.CustomerID = c.CustomerID
LEFT JOIN ServiceTotals stot ON sa.AppointmentID = stot.AppointmentID
LEFT JOIN PartsTotals ptot ON sa.AppointmentID = ptot.AppointmentID

WHERE sa.AppointmentID = @AppointmentID AND sa.DateDeleted IS NULL;
</CommandText>
