        <Tables>
          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="dtaMissedAppointmentsTableAdapter" GeneratorDataComponentClassName="dtaMissedAppointmentsTableAdapter" Name="dtaMissedAppointments" UserDataComponentName="dtaMissedAppointmentsTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="DoCarsDBConnectionString (Settings)" DbObjectName="dbo.ServiceAppointments" DbObjectType="Table" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT 
sa.AppointmentID,
s.Firstname + ' ' + s.Surname AS 'Mechanic',
v.Make + ' ' + v.Model AS 'Car',
sa.AppointmentStart
FROM ServiceAppointments AS sa
INNER JOIN Staff AS s
ON sa.StaffID = s.StaffID
INNER JOIN Vehicles as v
ON v.VehicleID = sa.VehicleID
-- where the appointment was supposed to finished before the current time and it is not completed
WHERE sa.Completed = 0 AND sa.AppointmentEnd &lt; GETDATE() AND sa.DateDeleted IS NULL;</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
            </MainSource>
