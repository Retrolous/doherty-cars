            <MainSource>
              <DbSource ConnectionRef="DoCarsDBConnectionString (Settings)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>-- retrieve the total revenue generated by services grouped by staff member, appointment and date
WITH ServiceTotals AS
(
    
SELECT
        
sa.AppointmentID,
       
sa.StaffID,
        
-- store the representative month as the date of the appointment with the day set to 1
DATEFROMPARTS(YEAR(sa.AppointmentStart), MONTH(sa.AppointmentStart), 1) AS AppointmentMonth,
        SUM(s.Price) AS ServiceRevenue,
       
sa.Discounted
    
FROM ServiceAppointments sa
    
JOIN ServiceAppointmentsServices sas
        
ON sa.AppointmentID = sas.AppointmentID
    
JOIN Services s
        
ON sas.ServiceID = s.ServiceID
    
WHERE sa.Completed = 1
  AND sa.Paid = 1  AND sas.DateDeleted IS NULL
GROUP BY
       
 sa.AppointmentID,
        
sa.StaffID,
        
DATEFROMPARTS(YEAR(sa.AppointmentStart), MONTH(sa.AppointmentStart), 1),
        
sa.Discounted
),
-- retrieve the total revenue generated by parts, grouped by appointment

PartTotals AS
(
    
SELECT
        
sasp.AppointmentID,
        
SUM(p.SellPrice * sasp.Quantity) AS PartsRevenue,
        
SUM(p.BuyPrice * sasp.Quantity) AS PartsCost
    
FROM ServiceAppointmentsServicesParts sasp
    
JOIN Parts p
        
ON sasp.PartID = p.PartID
   
JOIN ServiceAppointments sa
ON sa.AppointmentID = sasp.AppointmentID
WHERE sa.Completed = 1 AND sa.Paid = 1 AND sa.DateDeleted IS NULL AND sasp.DateDeleted IS NULL
GROUP BY
        
sasp.AppointmentID
)


SELECT
   
 st.StaffID,
    
st.AppointmentMonth,
   
 s.Firstname,
    
s.Surname,
-- sum the service revenue and the parts revenue for the current appointment, ensuring no parts and discounts are handled properly
SUM(
        
(
            
CASE 
                
WHEN st.Discounted = 1
                    
THEN (st.ServiceRevenue + ISNULL(pt.PartsRevenue,0)) * 0.9
                
ELSE (st.ServiceRevenue + ISNULL(pt.PartsRevenue,0))
            
END
       
 )
        - ISNULL(pt.PartsCost,0)
    ) 
AS MonthlyProfit

FROM ServiceTotals st

-- left join in case no parts are needed for the appointment
LEFT JOIN PartTotals pt
    
ON st.AppointmentID = pt.AppointmentID


JOIN Staff s
    
ON st.StaffID = s.StaffID


GROUP BY
    
st.StaffID,
    
st.AppointmentMonth,

s.Firstname,
    
s.Surname

ORDER BY
    
st.AppointmentMonth;</CommandText>
