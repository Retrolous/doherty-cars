                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT  
-- calculate total profits
SUM(v.SellPrice - v.BuyPrice) AS 'TotalProfits', 
vt.Name AS 'VehicleType' FROM Vehicles AS v 
INNER JOIN VehicleTypes AS vt 
ON v.VehicleTypeID = vt.VehicleTypeID 
WHERE v.CustomerID IS NOT NULL AND v.DateDeleted IS NULL 
-- group by the vehicle type
GROUP BY vt.Name; </CommandText>
